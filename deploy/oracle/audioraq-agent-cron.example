# Example Sunday founder standup schedule for the OCI host.
# Install manually with `crontab -e` after setting the real founder email.
#
# Runs every Sunday at 09:00 server time:
0 9 * * 0 cd /home/ubuntu/audioraq && /usr/bin/python3 scripts/audioraq_standup_agent.py --founder-email founder@audioraq.com >> /home/ubuntu/audioraq/logs/standup-agent.log 2>&1
