FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8001

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg espeak-ng gosu && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.prod.txt ./backend/requirements.prod.txt
RUN pip install --no-cache-dir -r backend/requirements.prod.txt

COPY backend ./backend
COPY memory ./memory
COPY frontend/build ./frontend/build
COPY deploy/oracle/runtime-entrypoint.sh ./runtime-entrypoint.sh

RUN useradd --create-home --shell /usr/sbin/nologin audioraq \
    && mkdir -p /app/data/media \
    && chown -R audioraq:audioraq /app/data /app/memory \
    && chmod +x ./runtime-entrypoint.sh

EXPOSE 8001

ENTRYPOINT ["./runtime-entrypoint.sh"]
CMD ["sh", "-c", "uvicorn backend.server:app --host 0.0.0.0 --port ${PORT}"]
