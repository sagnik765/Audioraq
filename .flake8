[flake8]
# This codebase predates any lint gate. The style families (E1/E2/E3/E5/W)
# currently report ~1,700 pre-existing line-length and import-placement
# findings, so enforcing them today would mean a reformat of every file.
# The gate therefore starts with the checks that catch real defects --
# pyflakes (F: undefined names, unused imports, redefinitions) plus syntax
# errors (E9) -- and can be widened once the cosmetic backlog is cleared.
select = E9,F
exclude =
    .git,
    __pycache__,
    .venv,
    node_modules,
    frontend,
    build
